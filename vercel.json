{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/services/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/api"
    },
    {
      "source": "/open/(.*)",
      "destination": "/api"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/admin",
      "permanent": false
    }
  ]
}
